# Firebase 웹 앱 설정값 (Firebase 콘솔 > 프로젝트 설정 > 내 앱)
# 로컬: 이 파일을 .env 로 복사해 채운다. 배포: GitHub 저장소 Variables 에 같은 이름으로 등록한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 기존 프로젝트를 쓸 때: 블로그 전용 Firestore 데이터베이스 ID (예: blog). 비우면 기본 데이터베이스를 쓴다.
VITE_FIREBASE_DATABASE_ID=
# 글을 쓸 수 있는 구글 계정 (화면 표시용. 실제 권한은 Firestore 규칙으로 막는다)
VITE_ADMIN_EMAIL=
# Google Analytics 4 측정 ID (G-로 시작). 비우면 방문을 집계하지 않는다.
VITE_GA_MEASUREMENT_ID=
# AI 제안 기능용 App Check 사이트 키 (Google Cloud > Fraud Defense > 키). 공개되어도 되는 값이다. 로컬 개발 서버는 비워 두고 디버그 토큰을 쓴다.
VITE_RECAPTCHA_SITE_KEY=
