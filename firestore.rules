rules_version = '2';

// 글(posts): 발행된 공개 글은 누구나 읽고, 쓰기·수정·삭제와 나머지 읽기는 관리자 계정만 가능하다.
// ADMIN_EMAIL_HERE 를 글을 쓸 구글 계정 주소로 바꿔서 Firebase 콘솔 > Firestore > 규칙에 붙여 넣는다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ADMIN_EMAIL_HERE';
    }

    match /posts/{postId} {
      allow read: if isAdmin()
        || (resource.data.status == 'published' && resource.data.visibility == 'public');
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 200000;
      allow delete: if isAdmin();

      // 반응(좋아요, 스크랩): 누구나 읽고, 방문자는 자기 문서(문서 ID = 본인 uid)만 쓴다. 발행된 공개 글에만 가능하다.
      match /reactions/{userId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['like', 'scrap', 'updatedAt'])
          && request.resource.data.like is bool
          && request.resource.data.scrap is bool
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published'
          && get(/databases/$(database)/documents/posts/$(postId)).data.visibility == 'public';
        allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }

    // 카테고리: 누구나 읽고, 추가·수정·삭제는 관리자만 가능하다.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.order is number;
      allow delete: if isAdmin();
    }
  }
}
